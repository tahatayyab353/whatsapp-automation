# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_receptionist

# JWT Authentication Configuration (CHUNK 3)
JWT_SECRET_KEY=CHANGE_ME_IN_DEVELOPMENT_AT_LEAST_32_BYTES_LONG!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI Engine Configuration (CHUNK 5)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=500
AI_REQUEST_TIMEOUT_SECONDS=20

# Meta / WhatsApp Cloud API Configuration (CHUNK 6)
WHATSAPP_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
